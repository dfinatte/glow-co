rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Clientes (sem login) podem criar pedidos no checkout de qualquer dispositivo
      allow create: if true;

      // Leitura liberada para que o cliente veja a confirmação do PIX em tempo real
      // (subscribeToSingleOrder no Checkout.tsx monitora o próprio pedido)
      allow read: if true;

      // Somente o admin logado com Google pode aprovar/alterar ou deletar pedidos
      allow update, delete: if request.auth != null;
    }
  }
}
